/**
 * Cloudflare Workers config. `npm run build` produces the Angular bundle, then
 * `npx wrangler deploy` uploads it together with the Worker in worker/.
 *
 * The `vars` below are the production settings. They live here rather than in
 * the dashboard because a deploy clears dashboard-set plaintext variables —
 * which already happened once, and left the Worker with no recipients at all.
 * None of these are secret: both addresses are printed on the site's own
 * contact cards.
 *
 * RESEND_API_KEY is the one real secret and is NOT here. It is set in the
 * Cloudflare dashboard as an encrypted Secret, which does survive deploys.
 *
 * To send somewhere else while testing, override these in `.dev.vars`, which
 * is gitignored and only applies to `npm run dev:worker`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plastiban",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "vars": {
    "CONTACT_FROM": "Plastiban Website <website@send.plastiban.com>",
    "CONTACT_TO_LB": "info@plastiban.com",
    // Both offices currently share one inbox: uae@plastiban.com was never
    // created as a mailbox and hard-bounced, so enquiries would have been
    // lost. The two variables and the office routing stay separate on purpose,
    // so giving the U.A.E. its own address later is a one-line change here.
    // The subject line already names the office, so the two are easy to tell
    // apart in the meantime.
    "CONTACT_TO_AE": "info@plastiban.com"
  },
  "assets": {
    "directory": "./dist/plastiban-web/browser",
    "binding": "ASSETS",
    // One page, no router: anything unrecognised still gets the site.
    "not_found_handling": "single-page-application",
    // Without this the asset server would answer /api/* with the SPA fallback
    // before the Worker ever ran.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
