# Copy to `.dev.vars` for local runs of `npm run dev:worker`.
# `.dev.vars` is gitignored — never commit a real key.
#
# In production these are set in the Cloudflare dashboard under the Worker's
# Settings -> Variables and Secrets. RESEND_API_KEY must be a Secret.

RESEND_API_KEY=re_your_key_here

# Until send.plastiban.com is verified in Resend, keep the shared test sender.
# Resend only delivers from it to the address that owns the Resend account.
CONTACT_FROM=Plastiban Website <onboarding@resend.dev>

# Required. The Worker refuses to send when either is missing rather than
# guessing an address, so set both — to your own inbox while testing.
CONTACT_TO_LB=info@plastiban.me
CONTACT_TO_AE=uae@plastiban.me
